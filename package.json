{
  "name": "bwend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "convex dev --start 'vite'",
    "build": "tsc -b && vite build",
    "deploy:convex": "convex deploy",
    "deploy:convex:prod": "convex deploy --env-file .env.production",
    "deploy:vercel": "vercel deploy --prod",
    "deploy:prod": "npm run deploy:convex:prod && npm run deploy:vercel",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "convex": "^1.35.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.10"
  }
}
