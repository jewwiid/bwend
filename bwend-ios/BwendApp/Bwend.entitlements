<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: tapping bwend.xyz/m/<code> in Messages, Hinge, etc. opens the app
	     directly instead of Safari. Requires apple-app-site-association at bwend.xyz. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bwend.xyz</string>
	</array>
</dict>
</plist>
